{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },
        {
            "name": "DigitalBanking.API",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/DigitalBanking.API/DigitalBanking.API.csproj"
        },
        {
            "name": "Attach to .NET Functions",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:azureFunctions.pickProcess}"
        }
    ]
}